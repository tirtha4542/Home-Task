# FastAPI settings
APP_NAME=AI Chatbot Assessment
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Persistent chat storage
DATABASE_PATH=data/chat_memory.db

# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=45
TEMPERATURE=0.3
SYSTEM_PROMPT=You are a helpful conversational assistant. Provide clear, concise, and context-aware replies.
